# KrishiLink Frontend Environment Variables
# Copy this file to .env and fill in values if needed

# API base URL — points to your Flask backend
# Leave as-is for local development (Vite proxy handles this)
VITE_API_BASE_URL=http://localhost:5000

# Set to 'false' to use real API calls instead of demo data
VITE_DEMO_MODE=true

# Supabase (for future live auth — leave empty for demo mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
