# KrishiLink Backend Environment Variables
# Copy this file to .env and fill in values
# The app runs in DEMO MODE if these are left empty

FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# Supabase (leave empty for demo mode)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS allowed origin
FRONTEND_URL=http://localhost:5173
