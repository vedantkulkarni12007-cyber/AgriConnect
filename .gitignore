# KrishiLink .gitignore
# This file tells Git which files NOT to track
# Never commit secrets or local configuration!

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
env/
ENV/
.venv/
*.db
*.sqlite
*.sqlite3

# ---- Environment files (NEVER commit these!) ----
.env
backend/.env
frontend/.env

# ---- Node / Frontend ----
node_modules/
dist/
.vite/
*.local

# ---- IDE files ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*

# ---- Temporary files ----
*.tmp
*.temp
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
